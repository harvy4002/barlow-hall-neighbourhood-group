---
// Google Analytics 4. Renders nothing unless PUBLIC_GA_ID is set at build
// time (deploy.yml passes it from the GA_MEASUREMENT_ID repo variable).
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <!-- define:vars wraps this in an IIFE, so expose gtag on window explicitly -->
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
