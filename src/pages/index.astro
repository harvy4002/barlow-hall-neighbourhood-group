---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Barlow Hall Neighbourhood Group"
  heroImage="/images/hero-home.jpg"
  heroAlt="Aerial view of the Barlow Hall area in Chorlton Park"
>
  <!-- Intro section -->
  <section class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-semibold text-[#334355] mb-6 tracking-tight">
      Welcome to Barlow Hall Neighbourhood Group
    </h1>
    <div class="grid sm:grid-cols-2 gap-10 items-start">
      <div>
        <p class="text-gray-600 leading-relaxed mb-4">
          We're an <strong>award-winning community group</strong> of local Chorlton residents,
          councillors, park rangers and housing representatives who support the Barlow Hall area
          of Chorlton Park.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          Follow what we've been up to:
        </p>
        <ul class="space-y-3">
          <li>
            <a
              href="https://twitter.com/BarlowHallGroup"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[#334355] font-medium hover:text-[#4a7c59] transition-colors"
            >
              <span class="text-lg font-bold">𝕏</span>
              @BarlowHallGroup on Twitter / X
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/barlowhallneighbourhoodgroup/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[#334355] font-medium hover:text-[#4a7c59] transition-colors"
            >
              📷 @barlowhallneighbourhoodgroup on Instagram
            </a>
          </li>
          <li>
            <a
              href="https://www.facebook.com/BarlowHallNeighbourhoodGroup"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[#334355] font-medium hover:text-[#4a7c59] transition-colors"
            >
              👍 BarlowHallNeighbourhoodGroup on Facebook
            </a>
          </li>
        </ul>

        <div class="mt-8">
          <img
            src="/images/bhng-map.jpg"
            alt="Map showing the Barlow Hall Neighbourhood Group coverage area in Chorlton Park"
            class="rounded-lg shadow-md w-full max-w-md"
            loading="lazy"
          />
          <p class="text-sm text-gray-500 mt-2">Our coverage area in Chorlton Park.</p>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class="bg-[#f5f7f9] rounded-xl p-6">
          <h2 class="text-lg font-semibold text-[#334355] mb-3">Stay Connected</h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            For the latest news, updates and photos from the Barlow Hall area, follow us on
            social media or join us at one of our monthly meetings — all residents welcome!
          </p>
          <a
            href="https://www.facebook.com/BarlowHallNeighbourhoodGroup"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-[#334355] text-white text-sm font-medium px-5 py-2.5 rounded-lg hover:bg-[#4a7c59] transition-colors"
          >
            Visit our Facebook page →
          </a>
        </div>

        <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
          <h2 class="text-lg font-semibold text-[#334355] mb-2">🏆 Award-Winning Group</h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            BHNG were given recognition by Southway Housing Trust for the work it does in
            promoting the area — certificates, a star award and a hamper at the AGM.
          </p>
          <img
            src="/images/award.jpg"
            alt="BHNG award recognition from Southway Housing Trust"
            class="rounded-lg shadow-sm w-full"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Call-to-action strip -->
  <section class="bg-[#334355] text-white rounded-2xl p-8 text-center">
    <h2 class="text-2xl font-semibold mb-3">Get Involved</h2>
    <p class="text-gray-300 mb-6 max-w-xl mx-auto">
      We meet on the first Monday of every month. Everyone living in the Chorlton Park area
      is welcome — come along and have your say!
    </p>
    <a
      href="/meetings"
      class="inline-block bg-white text-[#334355] font-semibold px-6 py-3 rounded-lg hover:bg-gray-100 transition-colors"
    >
      Find out about meetings →
    </a>
  </section>
</Layout>
