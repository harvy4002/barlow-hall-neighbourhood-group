---
import Layout from '../layouts/Layout.astro';

// Update these details when meeting information changes
const nextMeeting = {
  date: 'TBC — check our social media for the latest', // e.g. 'Monday 4th August 2025 at 7:00pm'
  location: 'Saint Barnabas Church, 4 Hurstville Rd, Chorlton, Manchester M21 8DH',
  format: 'In person', // e.g. 'In person', 'Zoom video call', or 'Hybrid'
  zoomLink: '', // add Zoom link here if applicable
};
---

<Layout
  title="Meetings"
  description="Find out when and where Barlow Hall Neighbourhood Group meetings take place."
>
  <h1 class="text-3xl sm:text-4xl font-semibold text-[#334355] mb-8 tracking-tight">Meetings</h1>

  <!-- Next meeting banner -->
  <div class="bg-[#334355] text-white rounded-2xl p-7 mb-10">
    <h2 class="text-xl font-semibold mb-4">Next Meeting</h2>
    <dl class="space-y-3 text-sm sm:text-base">
      <div class="flex flex-col sm:flex-row sm:gap-4">
        <dt class="font-semibold text-gray-300 sm:w-24 shrink-0">Date</dt>
        <dd>{nextMeeting.date}</dd>
      </div>
      <div class="flex flex-col sm:flex-row sm:gap-4">
        <dt class="font-semibold text-gray-300 sm:w-24 shrink-0">Format</dt>
        <dd>{nextMeeting.format}</dd>
      </div>
      <div class="flex flex-col sm:flex-row sm:gap-4">
        <dt class="font-semibold text-gray-300 sm:w-24 shrink-0">Venue</dt>
        <dd>{nextMeeting.location}</dd>
      </div>
      {nextMeeting.zoomLink && (
        <div class="flex flex-col sm:flex-row sm:gap-4">
          <dt class="font-semibold text-gray-300 sm:w-24 shrink-0">Zoom</dt>
          <dd>
            <a href={nextMeeting.zoomLink} target="_blank" rel="noopener noreferrer"
               class="underline hover:no-underline">
              Join Zoom meeting
            </a>
          </dd>
        </div>
      )}
    </dl>
  </div>

  <!-- Regular schedule -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-[#334355] mb-4">Regular Schedule</h2>
    <p class="text-gray-600 leading-relaxed mb-3">
      We meet at <strong>7:00pm on the first Monday of every month</strong>. Meetings may
      be held in person, via Zoom video conferencing, or as a hybrid of both — follow us on
      social media for the latest details.
    </p>
    <p class="text-gray-600 leading-relaxed">
      All residents in the Chorlton Park area are welcome to attend. No need to book — just
      turn up!
    </p>
  </section>

  <!-- Venue map -->
  <section class="mb-10">
    <h2 class="text-xl font-semibold text-[#334355] mb-4">Venue Location</h2>
    <p class="text-gray-600 mb-4">
      <strong>Saint Barnabas Church</strong><br />
      4 Hurstville Road, Chorlton, Manchester M21 8DH
    </p>
    <div class="rounded-xl overflow-hidden shadow-md border border-gray-200">
      <iframe
        title="Saint Barnabas Church location map"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2375.612!2d-2.277!3d53.431!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487bb1e0a9c8f5fd%3A0x0!2sSaint+Barnabas+Church%2C+4+Hurstville+Rd%2C+Chorlton%2C+Manchester+M21+8DH!5e0!3m2!1sen!2suk!4v1!5m2!1sen!2suk"
        width="100%"
        height="420"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <p class="text-xs text-gray-400 mt-2">
      Map shows Saint Barnabas Church, 4 Hurstville Rd, Chorlton, Manchester M21 8DH.
    </p>
  </section>

  <!-- Contact / social -->
  <section class="bg-[#f5f7f9] rounded-2xl p-6">
    <h2 class="text-xl font-semibold text-[#334355] mb-3">Stay Up to Date</h2>
    <p class="text-gray-600 leading-relaxed mb-4">
      For the most up-to-date meeting announcements and agendas, follow us on social media:
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="https://www.facebook.com/BarlowHallNeighbourhoodGroup"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#334355] text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-[#4a7c59] transition-colors"
      >
        Facebook
      </a>
      <a
        href="https://twitter.com/BarlowHallGroup"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#334355] text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-[#4a7c59] transition-colors"
      >
        Twitter / X
      </a>
      <a
        href="https://www.instagram.com/barlowhallneighbourhoodgroup/"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#334355] text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-[#4a7c59] transition-colors"
      >
        Instagram
      </a>
    </div>
  </section>
</Layout>
