---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  heroImage?: string;
  heroAlt?: string;
}

const {
  title,
  description = 'Barlow Hall Neighbourhood Group — an award-winning community group supporting the Barlow Hall area of Chorlton Park, Manchester.',
  heroImage,
  heroAlt = '',
} = Astro.props;

const siteName = 'Barlow Hall Neighbourhood Group';
const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#meetings', label: 'Meetings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Barlow Hall, Neighbourhood Group, Chorlton, Chorlton Park, Manchester, community" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title === siteName ? title : `${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <title>{title === siteName ? title : `${title} | ${siteName}`}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="min-h-screen flex flex-col bg-white">

    <!-- Header & Nav -->
    <header class="bg-[#334355] text-white shadow-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="#home" class="shrink-0">
            <img
              src="/images/logo-horizontal.jpg"
              alt="Barlow Hall Neighbourhood Group"
              class="h-10 w-auto rounded"
            />
          </a>
          <!-- Desktop nav -->
          <nav class="hidden sm:flex gap-6" aria-label="Main navigation">
            {navLinks.map(link => (
              <a
                href={link.href}
                class="text-sm font-medium tracking-wide uppercase transition-colors pb-1 border-b-2 border-transparent text-gray-300 hover:text-white hover:border-gray-400"
              >
                {link.label}
              </a>
            ))}
          </nav>
          <!-- Mobile hamburger -->
          <button
            id="menu-btn"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="sm:hidden p-2 rounded-md hover:bg-white/10 transition-colors"
          >
            <span class="block w-6 h-0.5 bg-white mb-1.5"></span>
            <span class="block w-6 h-0.5 bg-white mb-1.5"></span>
            <span class="block w-6 h-0.5 bg-white"></span>
          </button>
        </div>
      </div>
      <!-- Mobile nav -->
      <nav id="mobile-menu" class="hidden sm:hidden bg-[#2a3a47] px-4 pb-4" aria-label="Mobile navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="block py-2 text-sm font-medium uppercase tracking-wide text-gray-300 hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <!-- Hero banner -->
    <div class="bg-[#f7f6f2] border-b border-gray-200 py-12 sm:py-16 flex flex-col items-center justify-center text-center px-4">
      <img
        src="/images/logo-stacked.png"
        alt="Barlow Hall Neighbourhood Group"
        class="w-44 sm:w-56 h-auto mx-auto"
        style="mix-blend-mode: multiply;"
      />
      <p class="mt-5 text-[#334355] text-base sm:text-lg font-medium max-w-md">
        A community group improving Chorlton Park for everyone
      </p>
      <a href="#home" class="mt-6 inline-flex items-center gap-1.5 text-sm text-[#4a7c59] font-medium hover:text-[#334355] transition-colors">
        Find out more
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Main content -->
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#334355] text-white mt-12">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-gray-300">
            &copy; {new Date().getFullYear()} Barlow Hall Neighbourhood Group. Chorlton, Manchester.
          </p>
          <div class="flex items-center gap-5">
            <a
              href="https://x.com/BarlowHallGroup"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              aria-label="Follow us on X (Twitter)"
            >
              𝕏 Twitter
            </a>
            <a
              href="https://www.instagram.com/barlowhallneighbourhoodgroup/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              aria-label="Follow us on Instagram"
            >
              Instagram
            </a>
            <a
              href="https://www.facebook.com/BarlowHallNeighbourhoodGroup"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              aria-label="Like us on Facebook"
            >
              Facebook
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(isOpen));
      });
      // Close mobile menu when any nav link is clicked
      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
        });
      });
      // Fade-in on scroll
      const observer = new IntersectionObserver(
        entries => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
